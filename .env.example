# =============================================================================
# ThreatLens AI Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# SECURITY: No AI provider secrets (DeepSeek, OpenAI, Claude) are stored here.
# All AI requests are routed through Supabase Edge Functions which manage
# provider credentials server-side.
# =============================================================================

# Supabase Configuration (required)
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key

# Edge Function Base URL (optional)
# EDGE_FUNCTION_BASE_URL=https://your-project.supabase.co/functions/v1

# Analytics & Monitoring (optional)
POSTHOG_API_KEY=your-posthog-key
POSTHOG_API_HOST=https://us.posthog.com
SENTRY_DSN=your-sentry-dsn

# App Configuration
APP_ENV=development
DEBUG_MODE=true
